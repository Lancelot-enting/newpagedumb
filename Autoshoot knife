local ClonesHitbox = {}

local function LimpiarHitboxEnemigo(playerName)
   if ClonesHitbox[playerName] then
      if ClonesHitbox[playerName].Part then ClonesHitbox[playerName].Part:Destroy() end
      ClonesHitbox[playerName] = nil
   end
end

local function InyectarHitboxCamuflada(player)
   if ClonesHitbox[player.Name] or not player.Character then return end
   local HRP = player.Character:FindFirstChild("HumanoidRootPart")
   if not HRP then return end
   
   local FakePart = Instance.new("Part")
   FakePart.Name = "Knife_HitboxDinamica" 
   FakePart.Size = Vector3.new(ESCALA_ANCHO, ESCALA_ALTO, LIMITE_MAX_LARGO)
   FakePart.Anchored = true
   FakePart.CanCollide = false
   FakePart.Color = Color3.fromRGB(255, 255, 255) 
   FakePart.Material = Enum.Material.ForceField
   FakePart.CastShadow = false
   FakePart.Transparency = OCULTAR_ESP_HITBOX and 1 or 0.6
   FakePart.Parent = player.Character
   
   ClonesHitbox[player.Name] = {Part = FakePart, TargetHRP = HRP}
end

pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()

        if not checkcaller() and getgenv().JesushubKnifeAutoActive and getgenv().JesushubKnifeTargetPart then
            local target = getgenv().JesushubKnifeTargetPart
            
            if target and target.Parent then
                if method == "Raycast" and self == workspace then
                    local origin, direction, p3 = ...
                    if typeof(direction) == "Vector3" and direction.Magnitude > 20 then
                        local newDir = (target.Position - origin).Unit * 5000 
                        return oldNamecall(self, origin, newDir, p3)
                    end
                    
                elseif string.find(method, "FindPartOnRay") and self == workspace then
                    local ray, p2, p3, p4 = ...
                    if typeof(ray) == "Ray" and ray.Direction.Magnitude > 20 then
                        local newRay = Ray.new(ray.Origin, (target.Position - ray.Origin).Unit * 5000)
                        return oldNamecall(self, newRay, p2, p3, p4)
                    end
                end
            else
                getgenv().JesushubKnifeTargetPart = nil
            end
        end

        return oldNamecall(self, ...)
    end)
end)

