local function actualizarUIKnife(estado)
    getgenv().JesushubKnifeAutoActive = estado
    if not estado then 
        getgenv().JesushubKnifeTargetPart = nil 
        for name, _ in pairs(ClonesHitbox) do LimpiarHitboxEnemigo(name) end
    end
    TweenService:Create(knifeKnob, TweenInfo.new(0.2), {Position = estado and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)}):Play()
    TweenService:Create(knifeTrack, TweenInfo.new(0.2), {BackgroundColor3 = estado and Color3.fromRGB(76, 175, 80) or Color3.fromRGB(45, 45, 45)}):Play()
end

