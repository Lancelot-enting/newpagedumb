local function esCuchilloValido(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local name = string.lower(tool.Name)
    if tool:FindFirstChild("Slash") or tool:FindFirstChild("FlingKnifeEvent") or string.find(name, "knife") or string.find(name, "cuchillo") then
        return true
    end
    return false
end

task.spawn(function()
    while screenGui.Parent do
        task.wait(0.005)

        if not getgenv().JesushubKnifeAutoActive then 
            for name, _ in pairs(ClonesHitbox) do LimpiarHitboxEnemigo(name) end
            getgenv().JesushubKnifeTargetPart = nil
            task.wait(0.2)
        else
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
            
            local rootPart = char.HumanoidRootPart
            local myPos = rootPart.Position
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health <= 0 then continue end

            local armaActual = char:FindFirstChildOfClass("Tool")
            if not esCuchilloValido(armaActual) then
                getgenv().JesushubKnifeTargetPart = nil
                for name, _ in pairs(ClonesHitbox) do LimpiarHitboxEnemigo(name) end
                continue
            end

            local closestTargetPart = nil
            local shortestDistance = math.huge
            local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

            local playersList = Players:GetPlayers()
            for i = 1, #playersList do
                local p = playersList[i]
                
                -- Se conecta directo a la caché global del script principal para leer los Chams activos[span_0](start_span)[span_0](end_span)
                local cacheGlobal = getgenv().CacheClasificacion
                local esEnemigoValido = cacheGlobal and cacheGlobal.Chams and cacheGlobal.Chams[p.Name] == true

                if esEnemigoValido and p.Character then
                    local personaje = p.Character
                    local HRP = personaje:FindFirstChild("HumanoidRootPart")
                    local enemyHum = personaje:FindFirstChildOfClass("Humanoid")
                    
                    if HRP and enemyHum and enemyHum.Health > 0 then
                        local dist = (HRP.Position - myPos).Magnitude
                        local screenPos, onScreen = Camera:WorldToViewportPoint(HRP.Position)
                        local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        
                        if distToCenter < FOV_SIZE and dist <= 1000 then
                            local rayParams = RaycastParams.new()
                            rayParams.FilterDescendantsInstances = {char, personaje}
                            rayParams.FilterType = Enum.RaycastFilterType.Exclude
                            rayParams.IgnoreWater = true

                            local resultadoRay = workspace:Raycast(myPos, HRP.Position - myPos, rayParams)
                            
                            if not resultadoRay then
                                if not ClonesHitbox[p.Name] or not ClonesHitbox[p.Name].Part or not ClonesHitbox[p.Name].Part.Parent then
                                    LimpiarHitboxEnemigo(p.Name)
                                    InyectarHitboxCamuflada(p)
                                end
                                
                                local datos = ClonesHitbox[p.Name]
                                if datos and datos.Part then
                                    datos.Part.Transparency = 1
                                    local largoDinamico = math.clamp(dist - 1, 1, LIMITE_MAX_LARGO)
                                    datos.Part.Size = Vector3.new(ESCALA_ANCHO, ESCALA_ALTO, largoDinamico)
                                    datos.Part.CFrame = CFrame.new(HRP.Position, Vector3.new(myPos.X, HRP.Position.Y, myPos.Z))
                                    datos.Part.CanCollide = false
                                    datos.Part.Anchored = true
                                end

                                if dist < shortestDistance then
                                    shortestDistance = dist
                                    closestTargetPart = HRP
                                end
                            else
                                LimpiarHitboxEnemigo(p.Name)
                            end
                        else
                            LimpiarHitboxEnemigo(p.Name)
                        end
                    else
                        LimpiarHitboxEnemigo(p.Name)
                    end
                else
                    if p ~= LocalPlayer and ClonesHitbox[p.Name] then
                        LimpiarHitboxEnemigo(p.Name)
                    end
                end
            end

            if closestTargetPart then
                getgenv().JesushubKnifeTargetPart = closestTargetPart
                
                pcall(function()
                    armaActual:Activate()
                    task.defer(function()
                        if armaActual.Parent == char then
                            armaActual:Deactivate()
                        end
                    end)
                end)
            else
                getgenv().JesushubKnifeTargetPart = nil
            end
        end
    end
end)
